msgid "%s — Sign in"
msgstr "%s — ورود"

msgid "A confirmed email remains on the account when enrollment is disabled."
msgstr "با غیرفعال شدن امکان افزودن ایمیل، ایمیل تأییدشده قبلی در حساب باقی می‌ماند."

msgid "ACh WP Accounts"
msgstr "ACh WP Accounts"

msgid "ACh WP Accounts could not initialize its database or scheduled cleanup. Check site health and database permissions."
msgstr "افزونه نتوانست پایگاه داده یا پاک‌سازی زمان‌بندی‌شده را آماده کند. وضعیت سلامت سایت و دسترسی‌های پایگاه داده را بررسی کنید."

msgid "API key"
msgstr "کلید API"

msgid "Accent color"
msgstr "رنگ اصلی"

msgid "Accepted"
msgstr "پذیرفته‌شده"

msgid "Accepted by provider"
msgstr "پذیرفته‌شده توسط ارائه‌دهنده"

msgid "Account access"
msgstr "دسترسی به حساب کاربری"

msgid "Account and checkout"
msgstr "حساب و پرداخت"

msgid "Account data is temporarily unavailable."
msgstr "اطلاعات حساب موقتاً در دسترس نیست."

msgid "Account operations"
msgstr "عملیات حساب"

msgid "Account registration is not available here. Please sign in to your existing account or contact support."
msgstr "ثبت‌نام در این بخش امکان‌پذیر نیست. وارد حساب فعلی خود شوید یا با پشتیبانی تماس بگیرید."

msgid "Account settings"
msgstr "تنظیمات حساب"

msgid "Accounts status"
msgstr "وضعیت حساب‌ها"

msgid "Active"
msgstr "فعال"

msgid "Active SMS provider"
msgstr "ارائه‌دهنده فعال پیامک"

msgid "Add mobile number"
msgstr "افزودن شماره موبایل"

msgid "Additional mobile verification"
msgstr "تأیید مجدد موبایل"

msgid "Additional template tokens"
msgstr "متغیرهای اضافی الگو"

msgid "Adjust these limits to the site traffic and provider capacity. Limits apply to test messages too."
msgstr "این سقف‌ها را متناسب با ترافیک سایت و ظرفیت ارائه‌دهنده تنظیم کنید. محدودیت‌ها شامل پیامک‌های آزمایشی نیز می‌شوند."

msgid "Advanced traffic and verification limits"
msgstr "محدودیت‌های پیشرفته ارسال و تأیید"

msgid "After reviewing native account side effects, confirm the exact matching reservation and user. Never creates another account."
msgstr "پس از بررسی آثار عملیات بومی حساب، رزرو و کاربر دقیقاً منطبق را تأیید کنید. حساب دیگری ایجاد نمی‌کند."

msgid "All"
msgstr "همه"

msgid "Allow eligible accounts to sign in with an SMS code."
msgstr "اجازه ورود به حساب‌های مجاز با کد پیامکی."

msgid "Allow eligible accounts to sign in with an SMS code. Native password sign-in remains available."
msgstr "ورود حساب‌های مجاز با کد پیامکی امکان‌پذیر باشد. ورود با رمز عبور همچنان در دسترس است."

msgid "Allow email as a sign-in identifier"
msgstr "اجازه ورود با ایمیل"

msgid "Allow guests to prove existing credentials and a new mobile without creating a duplicate account."
msgstr "کاربر می‌تواند با اثبات اطلاعات حساب موجود و تأیید موبایل، بدون ساخت حساب تکراری، شماره خود را متصل کند."

msgid "Allow mobile-based registration only where native site registration is enabled."
msgstr "ثبت‌نام با موبایل فقط در بخش‌هایی مجاز باشد که ثبت‌نام بومی سایت فعال است."

msgid "Allow native public email registration where the site permits it."
msgstr "ثبت‌نام عمومی با ایمیل در صورت مجاز بودن در تنظیمات سایت."

msgid "Allow optional recovery email"
msgstr "امکان افزودن ایمیل بازیابی"

msgid "Allow optional recovery password"
msgstr "امکان تنظیم رمز عبور اختیاری"

msgid "Allowed range: 1–168 hours."
msgstr "بازه مجاز: ۱ تا ۱۶۸ ساعت."

msgid "An existing account uses this email address. Recover that account before creating another account."
msgstr "حسابی با این ایمیل وجود دارد. برای جلوگیری از ساخت حساب تکراری، ابتدا حساب فعلی خود را بازیابی کنید."

msgid "Appearance"
msgstr "ظاهر"

msgid "Attempts exhausted"
msgstr "سقف تلاش تکمیل شده"

msgid "Attempts:"
msgstr "تعداد تلاش:"

msgid "Awaiting code"
msgstr "در انتظار کد"

msgid "Back"
msgstr "بازگشت"

msgid "Back to site"
msgstr "بازگشت به سایت"

msgid "Cancel"
msgstr "انصراف"

msgid "Cancel verification"
msgstr "لغو تأیید شماره"

msgid "Category"
msgstr "دسته‌بندی"

msgid "Change mobile number"
msgstr "تغییر شماره موبایل"

msgid "Change your mobile number."
msgstr "شماره موبایل جدید خود را وارد کنید."

msgid "Changes affect diagnostic history, not the separate lifecycle of verification challenges."
msgstr "این تغییر فقط بر تاریخچه عیب‌یابی اثر دارد و چرخه نگهداری درخواست‌های تأیید را تغییر نمی‌دهد."

msgid "Check HTTPS origin, database schema and scheduled cleanup before enabling mobile sign-in."
msgstr "پیش از فعال‌سازی ورود با موبایل، آدرس HTTPS، ساختار پایگاه داده و پاک‌سازی زمان‌بندی‌شده را بررسی کنید."

msgid "Check provider access without sending a message."
msgstr "بررسی دسترسی به ارائه‌دهنده بدون ارسال پیامک."

msgid "Check the indicated settings field and try again."
msgstr "فیلد مشخص‌شده را بررسی کنید و دوباره تلاش کنید."

msgid "Check the provider credentials and the selected pattern or text configuration."
msgstr "اطلاعات اتصال و تنظیمات الگو یا متن پیامک را بررسی کنید."

msgid "Check your email"
msgstr "ایمیل خود را بررسی کنید"

msgid "Check your email for the confirmation link. Your account email has not changed yet."
msgstr "لینک تأیید را در ایمیل خود بررسی کنید. ایمیل حساب شما هنوز تغییر نکرده است."

msgid "Check your email to complete registration."
msgstr "برای تکمیل ثبت‌نام ایمیل خود را بررسی کنید."

msgid "Checking…"
msgstr "در حال بررسی…"

msgid "Checkout"
msgstr "تسویه‌حساب"

msgid "Choose an available recovery method."
msgstr "روش بازیابی رمز عبور را انتخاب کنید."

msgid "Close"
msgstr "بستن"

msgid "Code lifetime (seconds)"
msgstr "مدت اعتبار کد (ثانیه)"

msgid "Complete the required field."
msgstr "فیلد ضروری را تکمیل کنید."

msgid "Complete the required name fields."
msgstr "فیلدهای الزامی نام را کامل کنید."

msgid "Complete your account details"
msgstr "تکمیل اطلاعات حساب"

msgid "Configure provider"
msgstr "پیکربندی ارائه‌دهنده"

msgid "Confirm new password"
msgstr "تکرار رمز عبور جدید"

msgid "Confirm release of an exact reservation only when native account creation never started. Ambiguous native outcomes remain reserved."
msgstr "آزادسازی رزرو مشخص را فقط زمانی تأیید کنید که ایجاد حساب بومی هرگز شروع نشده باشد. رزروهای دارای نتیجه نامشخص حفظ می‌شوند."

msgid "Confirm removal of this provider configuration"
msgstr "حذف تنظیمات این ارائه‌دهنده را تأیید می‌کنم."

msgid "Confirm the requested action first."
msgstr "ابتدا عملیات درخواستی را تأیید کنید."

msgid "Confirm your existing account credentials and verify a mobile number to keep your account."
msgstr "اطلاعات ورود به حساب فعلی خود را تأیید کنید و شماره موبایل را احراز کنید تا همان حساب حفظ شود."

msgid "Confirm your recovery email for %s"
msgstr "تأیید ایمیل بازیابی حساب در %s"

msgid "Connected"
msgstr "اتصال موفق"

msgid "Connection"
msgstr "اتصال"

msgid "Connection credentials"
msgstr "اطلاعات اتصال"

msgid "Connection history reflects earlier tests, not a live health or delivery guarantee."
msgstr "تاریخچه اتصال نشان‌دهنده نتیجه آزمایش‌های قبلی است، نه تضمین وضعیت فعلی یا تحویل پیامک."

msgid "Connection test"
msgstr "آزمایش اتصال"

msgid "Continue checkout"
msgstr "ادامه خرید"

msgid "Continue to destination"
msgstr "ادامه به صفحه مقصد"

msgid "Continue with mobile number"
msgstr "ادامه با شماره موبایل"

msgid "Corner radius (px)"
msgstr "گردی کادر (پیکسل)"

msgid "Correlation ID"
msgstr "شناسه پیگیری"

msgid "Could not load this account method. Please try again."
msgstr "این روش دسترسی به حساب بارگذاری نشد. دوباره تلاش کنید."

msgid "Could not reach the verification service. Please try again."
msgstr "ارتباط با سرویس تأیید برقرار نشد. دوباره تلاش کنید."

msgid "Current password"
msgstr "رمز عبور فعلی"

msgid "Custom image"
msgstr "تصویر سفارشی"

msgid "Customer"
msgstr "مشتری"

msgid "Customer password sign-in"
msgstr "ورود مشتری با رمز عبور"

msgid "Customers must sign in and have a verified mobile before payment."
msgstr "مشتریان پیش از پرداخت باید وارد حساب شده و شماره موبایل احرازشده داشته باشند."

msgid "Customers must verify their mobile before payment, regardless of their sign-in method."
msgstr "مشتریان باید پیش از پرداخت، صرف‌نظر از روش ورود، شماره موبایل خود را تأیید کنند."

msgid "Default message"
msgstr "پیام پیش‌فرض"

msgid "Delivery may have occurred. Do not automatically send another message."
msgstr "ممکن است پیامک ارسال شده باشد. پیام دیگری به‌صورت خودکار ارسال نکنید."

msgid "Desktop"
msgstr "دسکتاپ"

msgid "Details"
msgstr "جزئیات"

msgid "Diagnostic events"
msgstr "رویدادهای عیب‌یابی"

msgid "Diagnostic history"
msgstr "تاریخچه عیب‌یابی"

msgid "Diagnostic retention"
msgstr "نگهداری گزارش‌ها"

msgid "Diagnostics"
msgstr "عیب‌یابی"

msgid "Disable required mobile checkout before disabling mobile sign-in."
msgstr "قبل از غیرفعال‌کردن ورود با موبایل، الزام تأیید موبایل برای خرید را غیرفعال کنید."

msgid "Disabled"
msgstr "غیرفعال"

msgid "Discard changes"
msgstr "صرف‌نظر از تغییرات"

msgid "Duration (ms)"
msgstr "مدت عملیات (میلی‌ثانیه)"

msgid "Edit number"
msgstr "ویرایش شماره"

msgid "Email address"
msgstr "آدرس ایمیل"

msgid "Email or username"
msgstr "ایمیل یا نام کاربری"

msgid "Email or username sign-in and native email registration remain governed by WordPress and WooCommerce."
msgstr "ورود با ایمیل یا نام کاربری و ثبت‌نام ایمیلی مطابق تنظیمات وردپرس و ووکامرس باقی می‌ماند."

msgid "Email registration"
msgstr "ثبت‌نام با ایمیل"

msgid "Email registration requiring a native password setup link is unavailable while email password reset is disabled."
msgstr "ثبت‌نام ایمیلی که به پیوند تعیین رمز بومی نیاز دارد، هنگام غیرفعال بودن بازیابی رمز با ایمیل در دسترس نیست."

msgid "Empty inherits the default; 0–64 pixels."
msgstr "برای ارث‌بری خالی بگذارید؛ ۰ تا ۶۴ پیکسل."

msgid "Empty inherits the site background."
msgstr "برای ارث‌بری پس‌زمینه سایت خالی بگذارید."

msgid "Empty inherits the site color; otherwise use a six-digit hex color."
msgstr "برای ارث‌بری رنگ سایت خالی بگذارید؛ یا رنگ هگزادسیمال شش‌رقمی وارد کنید."

msgid "Enable JavaScript to verify your mobile number. Native sign-in remains available where permitted."
msgstr "برای تأیید شماره موبایل، JavaScript مرورگر را فعال کنید. در صورت مجاز بودن، ورود با روش‌های دیگر همچنان امکان‌پذیر است."

msgid "Enable mobile sign-in or keep password sign-in available to customers."
msgstr "ورود با موبایل را فعال کنید یا امکان ورود مشتریان با رمز عبور را حفظ کنید."

msgid "Enabled"
msgstr "فعال"

msgid "Enter a valid mobile number before payment."
msgstr "پیش از پرداخت شماره موبایل معتبری وارد کنید."

msgid "Enter one value per line in the provider template order. Include {code} where the verification code belongs."
msgstr "هر مقدار را مطابق ترتیب الگوی ارائه‌دهنده در یک خط وارد کنید. در محل کد تأیید از {code} استفاده کنید."

msgid "Enter the code sent to your mobile number."
msgstr "کد ارسال‌شده به شماره موبایل خود را وارد کنید."

msgid "Enter the mobile number already verified on your account."
msgstr "شماره موبایلی را وارد کنید که قبلاً در حساب شما تأیید شده است."

msgid "Enter your email or username."
msgstr "ایمیل یا نام کاربری خود را وارد کنید."

msgid "Enter your mobile number."
msgstr "شماره موبایل خود را وارد کنید."

msgid "Existing accounts without a mobile number may lose access. Review recovery before disabling sign-in methods."
msgstr "حساب‌های قبلی بدون شماره موبایل ممکن است دسترسی خود را از دست بدهند. پیش از غیرفعال کردن روش‌های ورود، مسیر بازیابی را بررسی کنید."

msgid "Existing native credentials remain unchanged."
msgstr "اطلاعات ورود قبلی بدون تغییر باقی می‌مانند."

msgid "Expired"
msgstr "منقضی‌شده"

msgid "Expiry (UTC)"
msgstr "انقضا (UTC)"

msgid "Explicitly send one potentially billable test message with the saved template. Requires confirmation and a unique request ID; exact replay is safe for the 24-hour challenge retention. The test cannot authenticate a customer."
msgstr "ارسال صریح یک پیامک آزمایشی با الگوی ذخیره‌شده که ممکن است هزینه داشته باشد. نیازمند تأیید و شناسه یکتای درخواست است. تکرار همان درخواست در بازه نگهداری ۲۴ساعته، پیامک دیگری ارسال نمی‌کند. این آزمایش امکان ورود مشتری را فراهم نمی‌کند."

msgid "Failed"
msgstr "ناموفق"

msgid "Field:"
msgstr "فیلد:"

msgid "Filter"
msgstr "فیلتر"

msgid "First name"
msgstr "نام"

msgid "For your protection, re-enter any new credentials before saving."
msgstr "برای حفظ اطلاعات محرمانه، پیش از ذخیره، اطلاعات اتصال جدید را دوباره وارد کنید."

msgid "Forgot password?"
msgstr "رمز عبور را فراموش کرده‌اید؟"

msgid "Form fields"
msgstr "فیلدهای فرم"

msgid "General"
msgstr "عمومی"

msgid "Get verification code"
msgstr "دریافت کد تأیید"

msgid "History unavailable"
msgstr "تاریخچه در دسترس نیست"

msgid "I confirm sending one potentially billable test message."
msgstr "ارسال یک پیامک آزمایشی را که ممکن است هزینه داشته باشد تأیید می‌کنم."

msgid "Identity source"
msgstr "منبع هویت"

msgid "If the account is eligible for recovery, a password reset link will be sent."
msgstr "اگر حساب واجد شرایط بازیابی باشد، پیوند تعیین رمز ارسال می‌شود."

msgid "Import reviewed Digits identities"
msgstr "انتقال هویت‌های بررسی‌شده Digits"

msgid "Import uncontested existing-account mappings from the exact approved source or manifest digest. Fresh OTP verifies possession. Confirm first; resume with next offset. Does not create, merge or overwrite accounts."
msgstr "نگاشت‌های بدون تعارض حساب‌های موجود را با شناسه دقیق تأییدشده منبع یا فهرست وارد کنید. مالکیت شماره با کد تأیید جدید احراز می‌شود. ابتدا تأیید کنید و سپس از موقعیت بعدی ادامه دهید. حسابی ایجاد، ادغام یا بازنویسی نمی‌شود."

msgid "Include {code} in the message. It is replaced with the verification code."
msgstr "از {code} در متن پیام استفاده کنید تا با کد تأیید جایگزین شود."

msgid "Inherit the site appearance by default. Overrides are limited to account components."
msgstr "به‌صورت پیش‌فرض ظاهر از سایت به ارث می‌رسد. تغییرات فقط روی اجزای حساب اعمال می‌شوند."

msgid "Inspect installed schema version and available provider capabilities. Does not send messages or access credentials."
msgstr "بررسی نسخه ساختار داده و قابلیت‌های ارائه‌دهندگان پیامک، بدون ارسال پیام یا دسترسی به اطلاعات محرمانه."

msgid "Inspect interrupted registrations"
msgstr "بررسی ثبت‌نام‌های نیمه‌تمام"

msgid "Invalid credentials."
msgstr "اطلاعات ورود صحیح نیست."

msgid "Keep password sign-in available to ordinary customers. Administrators and other privileged accounts retain native access. Check access for customers without a mobile number before disabling."
msgstr "ورود مشتریان عادی با رمز عبور را فعال نگه دارید. دسترسی بومی مدیران و حساب‌های دارای دسترسی ویژه حفظ می‌شود. پیش از غیرفعال‌سازی، دسترسی مشتریان بدون شماره موبایل را بررسی کنید."

msgid "Last connection test"
msgstr "آخرین آزمایش اتصال"

msgid "Last name"
msgstr "نام خانوادگی"

msgid "Link a mobile number to an existing account"
msgstr "اتصال شماره موبایل به حساب موجود"

msgid "Link an existing account"
msgstr "اتصال حساب موجود"

msgid "Link mobile to an existing account"
msgstr "اتصال شماره موبایل به حساب موجود"

msgid "Link or change mobile"
msgstr "اتصال یا تغییر شماره موبایل"

msgid "Loading settings…"
msgstr "در حال بارگذاری تنظیمات…"

msgid "Local font attachment ID"
msgstr "شناسه رسانه فونت محلی"

msgid "Logo"
msgstr "لوگو"

msgid "Logo media attachment ID"
msgstr "شناسه رسانه لوگو"

msgid "Manage recovery options"
msgstr "مدیریت گزینه‌های بازیابی"

msgid "Manage your mobile number"
msgstr "مدیریت شماره موبایل"

msgid "Maximum 600 seconds."
msgstr "حداکثر ۶۰۰ ثانیه."

msgid "Message purpose"
msgstr "کاربرد پیامک"

msgid "Message reference"
msgstr "شناسه پیامک"

msgid "Message text"
msgstr "متن پیامک"

msgid "Mobile"
msgstr "موبایل"

msgid "Mobile number"
msgstr "شماره موبایل"

msgid "Mobile number verified."
msgstr "شماره موبایل تأیید شد."

msgid "Mobile password reset"
msgstr "بازیابی رمز با موبایل"

msgid "Mobile registration"
msgstr "ثبت‌نام با موبایل"

msgid "Mobile registration fields"
msgstr "فیلدهای ثبت‌نام با موبایل"

msgid "Mobile session verification"
msgstr "تأیید موبایل نشست"

msgid "Mobile sign-in"
msgstr "ورود با موبایل"

msgid "Mobile sign-in is enabled but the saved provider is not ready. Review SMS settings."
msgstr "ورود با موبایل فعال است، اما ارائه‌دهنده آماده نیست. تنظیمات پیامک را بررسی کنید."

msgid "Mobile sign-in requires a compatible HTTPS site origin and installed database schema."
msgstr "ورود با موبایل به آدرس HTTPS سازگار و ساختار پایگاه داده نصب‌شده نیاز دارد."

msgid "Mobile verification"
msgstr "احراز شماره موبایل"

msgid "Mobile verification is temporarily unavailable."
msgstr "تأیید موبایل موقتاً در دسترس نیست."

msgid "Mobile verification is temporarily unavailable. Please try again later or contact support."
msgstr "تأیید موبایل موقتاً در دسترس نیست. بعداً دوباره تلاش کنید یا با پشتیبانی تماس بگیرید."

msgid "Mobile verification requests"
msgstr "درخواست‌های تأیید موبایل"

msgid "Mobile verified, but checkout could not be refreshed. Select Pay to try again."
msgstr "شماره موبایل تأیید شد اما به‌روزرسانی سفارش انجام نشد. برای تلاش مجدد دکمه پرداخت را بزنید."

msgid "Mobile verified. Review your order and select Pay to continue."
msgstr "شماره موبایل تأیید شد. سفارش را بررسی کنید و برای ادامه دکمه پرداخت را بزنید."

msgid "Mobile-created account"
msgstr "حساب ایجادشده با موبایل"

msgid "Multisite account identity is not supported by this development version."
msgstr "این نسخه توسعه از هویت حساب در وردپرس چندسایته پشتیبانی نمی‌کند."

msgid "My account"
msgstr "حساب کاربری"

msgid "Native account recovery evidence was retained to preserve access."
