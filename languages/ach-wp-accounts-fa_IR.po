msgid "Reset filters"
msgstr "پاک‌کردن فیلترها"

msgid "Result"
msgstr "نتیجه"

msgid "Retention (hours)"
msgstr "مدت نگهداری (ساعت)"

msgid "Retry request"
msgstr "تلاش مجدد"

msgid "SMS"
msgstr "پیامک"

