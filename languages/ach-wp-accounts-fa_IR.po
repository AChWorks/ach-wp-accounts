msgstr "پیامک عادی"

msgid "Passwords do not match."
msgstr "رمزهای عبور یکسان نیستند."

msgid "Pattern body ID"
msgstr "شناسه الگو"

msgid "Pattern values in order"
msgstr "مقادیر الگو به ترتیب"

