msgstr "شماره موبایل را بررسی کنید و دوباره تلاش کنید."

msgid "Please confirm your current account credentials."
msgstr "لطفاً اطلاعات ورود به حساب فعلی خود را تأیید کنید."

msgid "Please enter a valid email address."
msgstr "یک آدرس ایمیل معتبر وارد کنید."

msgid "Please sign in and verify your mobile number before continuing to payment."
msgstr "برای ادامه خرید، وارد حساب خود شوید و شماره موبایل را تأیید کنید."

msgid "Please sign in using your existing account credentials."
msgstr "لطفاً با اطلاعات ورود به حساب فعلی خود وارد شوید."

msgid "Preview reviewed Digits identities"
msgstr "پیش‌نمایش هویت‌های بررسی‌شده Digits"

msgid "Provider"
msgstr "ارائه‌دهنده"

msgid "Provider acceptance does not confirm delivery. Times use the WordPress site timezone."
msgstr "پذیرش پیامک توسط ارائه‌دهنده به معنی تحویل آن نیست. زمان‌ها مطابق منطقه زمانی سایت نمایش داده می‌شوند."

msgid "Provider code"
msgstr "کد ارائه‌دهنده"

msgid "Provider configuration"
msgstr "پیکربندی ارائه‌دهنده"

msgid "Provider tests"
msgstr "آزمایش ارائه‌دهنده"

msgid "Provider username"
msgstr "نام کاربری ارائه‌دهنده"

msgid "Query account diagnostics"
msgstr "بررسی رویدادهای عیب‌یابی حساب‌ها"

msgid "Read account settings"
msgstr "خواندن تنظیمات حساب‌ها"

